# Let Git normalise line endings of text files (rules below override this for specific files).
* text=auto

# Generated files that tests compare byte for byte with what they generate: LF on every OS, also
# where Git for Windows' core.autocrlf would check them out with CRLF.
docs/launcher-commands.md text eol=lf
docs/horizon-ctl-commands.md text eol=lf
crates/horizon-theme/tokens.css text eol=lf
docs/api/*-reference.md text eol=lf

# Shell scripts and hooks must keep LF or they break on Linux/macOS.
*.sh text eol=lf
.githooks/* text eol=lf

# Binary files: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.webm binary
*.ico binary
*.icns binary
*.zip binary
*.jar binary
